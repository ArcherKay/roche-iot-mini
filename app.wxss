page {
  height: 100%;
}
body {
  height: 100%;
}
button:after{
  content: none;
}
.clearfix:after {
   visibility: hidden;
   display: block;
   font-size: 0;
   content: ".";
   clear: both;
   height: 0;
}
.left{
   float: left;
}
.right{
   float: right;
}
.close{
   display: none;
}
.open{
   display: block;
}
.girl{
   color: #E76A78;
}
.boy{
   color: #1DA1F2;
}
.show{
 display: block;
}
.hidden{
 display: none;
}
.fontsize{
 font-size: 14px;
}
.grey-filter{
 filter: grayscale(100%);
}
.grey-filter:hover{
 filter: grayscale(0%);
}
.goods-price-text-two{
 position: relative;
 left: -4rpx;
}
.scroll-box{
 width: 100%;
 height: 100%;
}