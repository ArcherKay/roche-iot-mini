page {
  min-height: 100%;
  background: #eef6ff;
  color: #263b4a;
  font-family: "Avenir Next", "PingFang SC", sans-serif;
  font-size: 30rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.device-heading {
  margin: 8rpx 4rpx 28rpx;
}

.device-name {
  color: #29465b;
  font-size: 30rpx;
  font-weight: 600;
}

.device-code {
  margin-top: 10rpx;
  color: #70899a;
  font-size: 30rpx;
}

.chart-card {
  padding: 28rpx 20rpx 24rpx;
  border: 1rpx solid rgba(46, 105, 155, .1);
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(45, 91, 131, .07);
}

.chart-heading {
  margin: 0 8rpx 28rpx;
  color: #36566c;
  font-size: 30rpx;
  font-weight: 600;
}

.filter-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.filter-row {
  display: flex;
  flex-direction: column;
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid #e7eff5;
}

.filter-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.filter-row-heading,
.filter-row-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-name {
  color: #36566c;
  font-size: 30rpx;
  font-weight: 600;
}

.used-value {
  color: #2d79b0;
  font-size: 30rpx;
  font-weight: 600;
}

.used-value text {
  margin-left: 2rpx;
  font-size: 30rpx;
}

.chart-track {
  width: 100%;
  height: 24rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf3f7;
}

.chart-fill {
  height: 100%;
  border-radius: 999rpx;
}

.chart-fill.teal { background: #4d9bc9; }
.chart-fill.blue { background: #75a78a; }
.chart-fill.orange { background: #d5a04c; }

.remaining-value {
  min-width: 0;
  margin-top: 14rpx;
  color: #70899a;
  font-size: 30rpx;
}

.reset-button {
  width: 132rpx;
  height: 58rpx;
  flex-shrink: 0;
  margin: 12rpx 0 0 16rpx;
  border: 1rpx solid #b9d5e8;
  border-radius: 10rpx;
  color: #2d79b0;
  background: #f6fbff;
  font-size: 30rpx;
  line-height: 56rpx;
}

.reset-button::after {
  border: 0;
}

.reset-button[disabled] {
  color: #8ca4b5;
  background: #edf3f7;
}

.empty-state {
  padding: 100rpx 20rpx;
  color: #70899a;
  text-align: center;
}