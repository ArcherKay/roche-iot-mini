<view class="questionnaire-container">
  <view class="question-list">
    <block wx:for="{{QuestionnaireData}}" wx:key="id">
      <view class="question-item">
        <view class="question-title">
          <text>{{index + 1}}. {{item.title}}</text>
        </view>
        <view class="options">
          <block wx:if="{{item.type === 0}}">
            <radio-group class="radio-group" bindchange="onAnswerChange" data-id="{{item.id}}">
              <label class="option" wx:for="{{item.items}}" wx:for-item="option" wx:key="itemflag">
                <view class="option-wrapper">
                  <radio value="{{option.itemflag}}" color="#007AFF"/>
                  <text>{{option.itemContent}}</text>
                </view>
              </label>
            </radio-group>
          </block>
          <block wx:elif="{{item.type === 1}}">
            <radio-group class="radio-group" bindchange="onAnswerChange" data-id="{{item.id}}">
              <label class="option" wx:for="{{['正确', '错误']}}" wx:for-item="option" wx:key="index">
                <view class="option-wrapper">
                  <radio value="{{option}}" color="#007AFF"/>
                  <text>{{option}}</text>
                </view>
              </label>
            </radio-group>
          </block>
          <block wx:elif="{{item.type === 2}}">
            <checkbox-group class="checkbox-group" bindchange="onMultiAnswerChange" data-id="{{item.id}}">
              <label class="option" wx:for="{{item.items}}" wx:for-item="option" wx:key="itemflag">
                <view class="option-wrapper">
                  <checkbox value="{{option.itemflag}}" color="#007AFF"/>
                  <text>{{option.itemContent}}</text>
                </view>
              </label>
            </checkbox-group>
          </block>
        </view>
      </view>
    </block>
  </view>
  
  <button class="submit-btn" bindtap="submitQuestionnaire">提交问卷</button>
</view>