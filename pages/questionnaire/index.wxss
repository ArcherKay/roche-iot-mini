.questionnaire-container {
  padding: 20rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.question-list {
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
}

.question-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.question-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.options {
  margin-left: 20rpx;
}

.radio-group, .checkbox-group {
  display: flex;
  flex-direction: column;
}

.option {
  margin-bottom: 10rpx;
}

.option-wrapper {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
}

.option-wrapper radio, .option-wrapper checkbox {
  margin-right: 10rpx;
}

.option-wrapper text {
  font-size: 28rpx;
  color: #333;
}

.submit-btn {
  margin-top: 40rpx;
  background-color: #007AFF;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
}

.submit-btn:active {
  opacity: 0.8;
}