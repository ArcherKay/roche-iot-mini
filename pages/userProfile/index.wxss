.container {
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.form {
  background-color: #ffffff;
  padding: 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.input, .picker {
  font-size: 28rpx;
  padding: 20rpx;
  border: 1rpx solid #ccc;
  border-radius: 8rpx;
  background-color: #fff;
}

.submit-button {
  width: 100%;
  background-color: #e64340;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-top: 40rpx;
}
