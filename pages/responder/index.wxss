  display: flex;
  justify-content: space-between;
  align-items: center;
}

.aed-title {
  font-size: 18px;
  font-weight: bold;
} */

.aed-body {
  display: flex;
  flex-direction: column;
  margin-top: 10px;
  /* background-color: yellow; */
  justify-content: flex-start;
  align-items: flex-start;
}

.head-depart {
  flex-direction: row;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  /* background-color: #7f26f3; */
  height: 170rpx;
}

.aed-image {
  width: 60px;
  height: 60px;
  border-radius: 10px;
}

.info-detail {
  flex-direction: column;
  display: flex;
  width: 500rpx;

  justify-content: flex-start;
  align-items: flex-start;
  /* background-color: #FF6347; */

  font-size: 28rpx;
  margin-left: 20px;


}



.aed-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  font-size: 28rpx;
  /* padding: 0 10px; */
  /* background-color: aquamarine; */
}

.aed-sn, .aed-manufacturer, .aed-status, .aed-address, .aed-range, .aed-detail-position {
  margin-bottom: 3px;
}

.aed-footer {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-top: 10px;
  width: 100%;
  /* background-color: brown; */
}

.aed-button {
  background-color: #FF6347;
  color: white;
  border: none;
  padding: 7px;
  border-radius: 5px;
  font-size: 28rpx;
  font-weight: bolder;
  width: 100% !important;
}