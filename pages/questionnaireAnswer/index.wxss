.question-list {
  background-color: white;
  margin: 20rpx;
  border-radius: 10rpx;
}

.question-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.question-header {
  display: flex;
  align-items: baseline;
}

.question-number {
  color: #ff9900;
  font-weight: bold;
  margin-right: 10rpx;
}

.question-title {
  flex: 1;
}

.question-type {
  font-size: 24rpx;
  color: #888;
}

.answer-info {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  margin-top: 10rpx;
}

.correct-answer {
  color: #00c2b3;
}

.your-answer {
  color: #ff9900;
}

.analysis-button {
  text-align: right;
  color: #00c2b3;
  font-size: 28rpx;
  margin-top: 10rpx;
}