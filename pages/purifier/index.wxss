page {
  background: #eef6ff;
  color: #263b4a;
  font-family: "Avenir Next", "PingFang SC", sans-serif;
  font-size: 30rpx;
}

.page-title,
.picker-title,
.hero-label,
.hero-number,
.hero-time,
.hero-work-status,
.section-title,
.quality-value,
.quality-name,
.stat-value,
.filter-name,
.control-title,
.device-card-title {
  font-size: 30rpx;
}

.page {
  height: 100vh;
  box-sizing: border-box;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 46rpx 40rpx 38rpx;
  color: #193c54;
  background: linear-gradient(135deg, #d2e8ff 0%, #a9cef4 56%, #85b8e8 100%);
  border-radius: 0 0 36rpx 36rpx;
}

.hero:after {
  content: "";
  position: absolute;
  right: -100rpx;
  top: -150rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1px solid rgba(42, 111, 171, .16);
  border-radius: 50%;
  box-shadow: 0 0 0 42rpx rgba(42, 111, 171, .06), 0 0 0 84rpx rgba(42, 111, 171, .03);
}

.hero-top,
.hero-bottom {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.eyebrow,
.section-kicker {
  letter-spacing: 3rpx;
  font-weight: 600;
}

.eyebrow {
  color: #286eab;
}

.page-title {
  margin-top: 10rpx;
  line-height: 1.1;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.device-picker {
  display: inline-block;
  max-width: 560rpx;
}

.picker-title {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  line-height: 1.1;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.picker-arrow {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  margin: -6rpx 14rpx 0 12rpx;
  border-right: 4rpx solid #236999;
  border-bottom: 4rpx solid #236999;
  transform: rotate(45deg);
}

.picker-hint {
  flex-shrink: 0;
  color: #286eab;
  font-weight: 400;
  letter-spacing: 0;
}

.device-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #3b5f7a;
  line-height: 1.45;
  word-break: break-all;
}

.online-dot,
.status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #8de2a5;
  box-shadow: 0 0 0 5rpx rgba(141, 226, 165, .14);
}

.status-pill {
  display: flex;
  align-items: center;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(39, 105, 163, .24);
  border-radius: 999rpx;
  color: #236999;
  background: rgba(255, 255, 255, .62);
}

.status-pill .status-dot {
  width: 10rpx;
  height: 10rpx;
}

.status-pill.offline .status-dot {
  background: #d48c33;
  box-shadow: none;
}

.hero-bottom {
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 26rpx;
}

.hero-metric {
  flex: 1;
  min-width: 0;
}

.volume-metric {
  flex: 1.2;
}

.service-metric {
  flex: .7;
}

.work-status-metric {
  flex: 1.15;
}

.hero-label {
  color: #386d92;
  font-weight: 400;
}

.hero-number {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  height: 42rpx;
  line-height: 1;
  font-weight: 700;
}

.hero-unit {
  color: #306b9c;
}

.hero-divider {
  width: 1rpx;
  height: 62rpx;
  flex-shrink: 0;
  margin: 0 16rpx;
  background: rgba(43, 98, 149, .24);
}

.hero-time {
  display: flex;
  align-items: center;
  height: 42rpx;
  margin-top: 6rpx;
  color: #234b6c;
  line-height: 1;
  font-weight: 700;
}

.hero-time.signal-good,
.device-info-row text.signal-status-value.signal-good {
  color: #258052;
  font-weight: 700;
}

.hero-time.signal-weak,
.device-info-row text.signal-status-value.signal-weak {
  color: #a97634;
  font-weight: 700;
}

.hero-time.signal-offline,
.device-info-row text.signal-status-value.signal-offline {
  color: #c25353;
  font-weight: 700;
}

.hero-work-status {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  height: 42rpx;
  margin-top: 6rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(39, 105, 163, .2);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, .68);
  color: #236999;
  font-weight: 700;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-work-status.water-full {
  color: #008f68;
  font-weight: 700;
}

.content {
  padding: 40rpx 32rpx 48rpx;
}

.loading-line {
  padding: 16rpx 32rpx 0;
  color: #62839a;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 0 6rpx 22rpx;
}

.section-kicker {
  color: #4d83ad;
}

.section-title {
  margin-top: 7rpx;
  color: #29465b;
  font-weight: 600;
}

.quality-badge {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: #236fa9;
  background: #d9ecfc;
}

.quality-card,
.filter-card,
.control-card,
.device-card {
  border: 1rpx solid rgba(46, 105, 155, .1);
  box-shadow: 0 10rpx 28rpx rgba(45, 91, 131, .07);
}

.quality-card {
  padding: 28rpx 26rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
}

.quality-main {
  display: flex;
  align-items: center;
}

.quality-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 190rpx;
  flex-shrink: 0;
  border: 10rpx solid #d5e9fa;
  border-top-color: #3e8fc9;
  border-right-color: #3e8fc9;
  border-radius: 50%;
  transform: rotate(-25deg);
}

.ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: rotate(25deg);
}

.quality-value {
  color: #246fa7;
  line-height: 1;
  font-weight: 600;
}

.quality-unit {
  margin-top: 9rpx;
  color: #71899a;
}

.quality-copy {
  margin-left: 28rpx;
}

.quality-name {
  color: #29465b;
  font-weight: 600;
}

.quality-desc,
.filter-life,
.control-desc {
  color: #70899a;
}

.quality-desc {
  margin-top: 10rpx;
  line-height: 1.5;
}

.quality-safe {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: #2d79b0;
}

.check-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  color: #fff;
  background: #3e88c2;
}

.quality-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e7eff5;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-label {
  color: #71899a;
  line-height: 1.35;
}

.stat-value {
  margin-top: 8rpx;
  color: #36566c;
  line-height: 1.25;
  font-weight: 600;
}

.stat-unit {
  color: #8196a5;
  font-weight: 400;
}

.filter-heading {
  margin-top: 42rpx;
}

.filter-detail-link {
  display: flex;
  align-items: center;
  padding: 8rpx 0 4rpx 16rpx;
  color: #2d79b0;
  font-size: 30rpx;
}

.filter-detail-arrow {
  margin-left: 6rpx;
  font-size: 30rpx;
  line-height: 1;
}

.filter-card {
  padding: 4rpx 26rpx;
  border-radius: 22rpx;
  background: #fff;
}

.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  border-bottom: 1rpx solid #e7eff5;
  color: #8196a5;
}

.filter-header-values {
  width: 220rpx;
  margin-left: 16rpx;
  text-align: right;
}

.filter-row {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  border-bottom: 1rpx solid #e7eff5;
}

.filter-row:last-child {
  border-bottom: 0;
}

.filter-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  font-weight: 600;
}

.filter-icon.teal { color: #286fa2; background: #dceefd; }
.filter-icon.blue { color: #547b65; background: #e8f0e8; }
.filter-icon.orange { color: #a97634; background: #f7eedc; }

.filter-main {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.filter-info {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.filter-name {
  color: #36566c;
  line-height: 1.3;
  font-weight: 600;
}

.filter-values {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  white-space: nowrap;
}

.filter-remaining,
.filter-total {
  color: #5d7c91;
}

.filter-separator {
  margin: 0 10rpx;
  color: #9aabb7;
}

.filter-track {
  height: 20rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf2f5;
}

.filter-progress {
  height: 100%;
  border-radius: 999rpx;
}

.filter-progress.teal { background: #4b9bc8; }
.filter-progress.orange { background: #d3a354; }

.control-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #d6e9f9;
}

.power-control-left {
  display: flex;
  min-width: 0;
  align-items: center;
}

.power-control-left .power-switch {
  flex-shrink: 0;
  margin: 0 18rpx 0 0;
}

.control-title {
  color: #294b63;
  font-weight: 600;
}

.control-desc {
  margin-top: 8rpx;
  color: #66859a;
}

.share-device-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 72rpx;
  margin: 0 0 0 12rpx;
  padding: 0 10rpx;
  border: 1rpx solid rgba(45, 121, 176, .25);
  border-radius: 12rpx;
  color: #236999;
  background: rgba(255, 255, 255, .72);
  font-size: 30rpx;
  line-height: 70rpx;
  white-space: nowrap;
}

.share-device-button::after {
  border: 0;
}

.share-device-button text {
  margin-left: 8rpx;
  font-size: 30rpx;
  line-height: 1;
}

.power-state {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #276f9e;
  background: rgba(255, 255, 255, .75);
}

.power-state.power-on {
  color: #286b96;
  background: #b9daf3;
}

.device-card {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 22rpx;
  background: #fff;
}

.device-card-title {
  margin-bottom: 16rpx;
  color: #29465b;
  font-weight: 600;
}

.device-info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e7eff5;
  color: #71899a;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.5;
}

.device-info-row text {
  font-size: 30rpx;
  font-weight: 400;
}

.device-info-row text:last-child {
  max-width: 65%;
  color: #36566c;
  text-align: right;
  word-break: break-all;
}

.device-info-row.last-row {
  border-bottom: 0;
}

.empty-filters {
  padding: 30rpx 0;
  color: #70899a;
  text-align: center;
}

