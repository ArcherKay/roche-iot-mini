<scroll-view class="page" scroll-y="true">
		<view class="hero">
			<view class="hero-top">
				<view>
					<view class="eyebrow">设备SN</view>
					<view class="device-picker" bindtap="openDeviceSelector">
						<view class="picker-title"><text>{{selectedDeviceId}}</text><view class="picker-arrow"></view><text class="picker-hint">切换设备</text></view>
					</view>
				</view>
				<view class="status-pill {{isOnline ? 'online' : 'offline'}}">
					<view class="status-dot"></view>
					<text>{{isOnline ? '在线' : '离线'}}</text>
				</view>
			</view>

			<view class="hero-bottom">
				<view class="hero-metric volume-metric">
					<view class="hero-label">总过滤量</view>
					<view class="hero-number">{{totalFilterVolume}}<text class="hero-unit"> L</text></view>
				</view>
				<view class="hero-divider"></view>
				<view class="hero-metric service-metric">
					<view class="hero-label">已服务</view>
					<view class="hero-number">{{serviceDay}}天</view>
				</view>
				<view class="hero-divider"></view>
				<view class="hero-metric">
					<view class="hero-label">信号强度</view>
					<view class="hero-time {{signalStatusClass}}">{{signalStatusText}}</view>
				</view>
				<view class="hero-divider"></view>
				<view class="hero-metric work-status-metric">
					<view class="hero-label">工作状态</view>
					<view class="hero-work-status {{workStatusClass}}">{{workStatusText}}</view>
				</view>
			</view>
		</view>
		<view wx:if="{{isLoading}}" class="loading-line">正在同步设备数据...</view>

	<view class="content">
		<view class="control-card power-control">
			<view class="power-control-left">
				<switch class="power-switch" color="#2d79b0" checked="{{isPowerOn}}" disabled="{{isSendingPower || isLoading}}" bindchange="onPowerSwitchChange" />
				<view class="control-copy">
					<view class="control-title">设备开关</view>
					<view class="control-desc">{{isSendingPower ? '正在发送指令...' : (isPowerOn ? '设备已开启' : '设备处于关闭状态')}}</view>
				</view>
			</view>
			<button class="share-device-button" bindtap="openSharedDeviceList">分享设备 <text>›</text></button>
		</view>

		<view class="section-heading">
			<view>
				<view class="section-kicker"></view>
				<view class="section-title">实时水质</view>
			</view>
			<view class="quality-badge">实时监测</view>
		</view>

		<view class="quality-card">
			<view class="quality-main">
				<view class="quality-ring">
					<view class="ring-inner">
						<text class="quality-value">{{waterQuality.tds}}</text>
						<text class="quality-unit">TDS / ppm</text>
					</view>
				</view>
				<view class="quality-copy">
					<view class="quality-name">出水水质</view>
					<view class="quality-desc">设备实时监测读数</view>
					<view class="quality-safe"><text class="check-mark">✓</text> </view>
				</view>
			</view>
			<view class="quality-stats">
				<view class="stat-item">
					<text class="stat-label">进水 TDS</text>
					<text class="stat-value">{{waterQuality.inlet}} <text class="stat-unit">ppm</text></text>
				</view>
				<view class="stat-item">
					<text class="stat-label">累计净水</text>
					<text class="stat-value">{{pureLitres}} <text class="stat-unit">L</text></text>
				</view>
				<view class="stat-item">
					<text class="stat-label">累计净化</text>
					<text class="stat-value">{{cleanLitres}} <text class="stat-unit">L</text></text>
				</view>
			</view>
		</view>

		<view class="section-heading filter-heading">
			<view>
				<view class="section-kicker"></view>
				<view class="section-title">滤芯寿命</view>
			</view>
			<view class="filter-detail-link" bindtap="openFilterLife">查看详情 <text class="filter-detail-arrow">›</text></view>
		</view>

		<view class="filter-card">
			<view class="filter-header">
				<view class="filter-header-name">滤芯</view>
				<view class="filter-header-values">剩余 / 总寿命</view>
			</view>
			<block wx:for="{{filters}}" wx:key="name">
				<view class="filter-row">
					<view class="filter-icon {{item.tone}}">{{item.shortName}}</view>
					<view class="filter-main">
						<view class="filter-values">
							<text class="filter-remaining">{{item.remain}}</text>
							<text class="filter-unit">天</text>
							<text class="filter-separator">/</text>
							<text class="filter-total">{{item.total}}</text>
							<text class="filter-unit">天</text>
						</view>
						<view class="filter-track">
							<view class="filter-progress {{item.tone}}" style="width: {{item.remainPercent}}%;"></view>
						</view>
					</view>
				</view>
			</block>
			<view wx:if="{{!filters.length}}" class="empty-filters">暂无滤芯寿命数据</view>
		</view>
		<view class="device-card">
			<view class="device-card-title">设备信息</view>
			<view class="device-info-row"><text>设备型号</text><text>{{deviceName}}</text></view>
			<view class="device-info-row"><text>序列号</text><text>{{serialNumber}}</text></view>
			<view class="device-info-row"><text>制造商</text><text>{{manufacturer}}</text></view>
			<view class="device-info-row"><text>固件版本</text><text>{{firmwareVersion}}</text></view>
			<view class="device-info-row"><text>IMEI</text><text>{{imei}}</text></view>
			<view class="device-info-row last-row"><text>信号状态</text><text class="signal-status-value {{signalStatusClass}}">{{signalStatusText}}</text></view>
		</view>

		</view>
	</scroll-view>


