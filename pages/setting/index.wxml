<view class="container">
  <view class="menu-list">
    <view class="menu-item" bindtap="navigateToServiceAgreement">
      <image class="menu-icon" src="/static/icon/item-user-rule.svg"></image>
      <view class="menu-text">用户服务协议</view>
      <image class="arrow" src="/static/icon/item-arrow.svg"></image>
    </view>
    <view class="menu-item" bindtap="navigateToPrivacyPolicy">
      <image class="menu-icon" src="/static/icon/item-privacy.svg"></image>
      <view class="menu-text">用户隐私协议</view>
      <image class="arrow" src="/static/icon/item-arrow.svg"></image>
    </view>
    <view class="menu-item" bindtap="navigateToAboutCompany">
      <image class="menu-icon" src="/static/icon/item-about.svg"></image>
      <view class="menu-text">关于公司</view>
      <image class="arrow" src="/static/icon/item-arrow.svg"></image>
    </view>
  </view>
  <view class="logout-container">
    <button class="logout-button" bindtap="logout">退出</button>
  </view>
</view>
