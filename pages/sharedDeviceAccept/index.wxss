page {
  min-height: 100%;
  background: #eef6ff;
  color: #263b4a;
  font-family: "Avenir Next", "PingFang SC", sans-serif;
  font-size: 30rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 100rpx 44rpx 48rpx;
  text-align: center;
}

.share-mark {
  color: #2d79b0;
  font-size: 30rpx;
  font-weight: 600;
}

.share-title {
  margin-top: 24rpx;
  color: #29465b;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.device-id {
  margin-top: 20rpx;
  color: #1e72e0;
  font-size: 30rpx;
  word-break: break-all;
}

.error-message {
  margin-top: 28rpx;
  color: #d62d13;
  font-size: 30rpx;
}

.accept-button {
  width: 100%;
  height: 88rpx;
  margin-top: 60rpx;
  border: 0;
  border-radius: 12rpx;
  color: #fff;
  background: #2d79b0;
  font-size: 30rpx;
  line-height: 88rpx;
}

.accept-button[disabled] {
  color: #edf3f7;
  background: #8caabd;
}

.accept-button::after {
  border: 0;
}