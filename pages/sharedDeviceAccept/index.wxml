<view class="page">
  <view class="share-title">有人邀请你查看一台萨奇净水器设备</view>
  <view class="share-mark">设备编号 {{deviceId}}</view>
  <view wx:if="{{error}}" class="error-message">{{error}}</view>
  <button
    class="accept-button"
    disabled="{{isSubmitting || isAccepted || !deviceId}}"
    bindtap="acceptShare"
  >{{isAccepted ? '已接受分享' : (isSubmitting ? '正在处理...' : '接受分享')}}</button>
</view>