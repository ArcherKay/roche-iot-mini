<view class="container">
  <view class="header">
    <text class="header-text">当前积分</text>
    <text class="score">{{totalScore}}</text>
  </view>
  
  <view class="score-detail">
    <block wx:for="{{scoreHistoryArrary}}" wx:key="id">
      <view class="score-detail-item">
        <view class="score-detail-left">
          <view class="score-comment">{{item.scoreComment}}</view>
          <view class="score-date">{{item.formattedDate}}</view>
        </view>
        <view class="reward-score">+{{item.rewardScore}}</view>
      </view>
    </block>
  </view>
</view>
