page {
  height: 100%;
  background: #ffffff;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding-top: 120rpx;
}

.welcome-title {
  position: relative;
  width: 80%;
  padding-bottom: 20rpx;
  color: #243d4c;
  font-size: 58rpx;
  line-height: 1.35;
  font-weight: 700;
  text-align: left;
}

.welcome-title:after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #fb1526;
}

.login-fields {
  width: 80%;
  margin-top: 150rpx;
}
.login-input {
  width: 100%;
  height: 96rpx;
  border-bottom: 1rpx solid #d8e0e5;
  color: #243d4c;
  font-size: 32rpx;
  box-sizing: border-box;
}
.login-input + .login-input {
  margin-top: 20rpx;
}
.password-field {
  position: relative;
  width: 100%;
  margin-top: 20rpx;
}
.password-input {
  padding-right: 80rpx;
}
.password-toggle {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 96rpx;
}
.password-eye {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 22rpx;
  border: 3rpx solid #8196a5;
  border-radius: 50%;
}
.password-eye:not(.is-visible)::after {
  content: "";
  position: absolute;
  width: 42rpx;
  height: 3rpx;
  background: #8196a5;
  transform: rotate(-40deg);
}
.password-eye-pupil {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #8196a5;
}
.register-btn {
  margin-top: 48rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 35rpx;
  color: #fff;
  background: #FB1526;
  width: 80% !important;
  display: flex;
  align-items: center; /* 垂直居中 */
  justify-content: center; /* 水平居中 */
  
}

.other-container {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 90rpx;
  /* background: #EF6507; */
}

.line {
  background: #888;
  width: 150rpx;
  height: 2rpx;
}
