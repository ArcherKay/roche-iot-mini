.agree-user-policy {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: auto;
  padding: 22rpx 24rpx 32rpx;
  box-sizing: border-box;
  position: relative;
  top: -18rpx;
}

.user-agree-title {
  color: #718394;
  font-size: 24rpx;
}

.agree-user {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.policy-radio {
  margin: 0;
  transform: scale(.86);
}

.agreement-links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.user-agreement {
  padding: 8rpx 10rpx;
  color: #2d79b0;
  font-size: 25rpx;
  line-height: 1.4;
}

.agreement-joiner {
  color: #a0acb6;
  font-size: 23rpx;
}

