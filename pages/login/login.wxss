page {
  height: 100%;
  background: #fff;
}

.container {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding-top: 120rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  /* background: #ffff00; */
}

.app-logo {
  /* background: #5daffb; */
  /* width: 512rpx; */
}
.app-logo>image {
  width: 280px;
  height: 144px;
}
.register-btn {
  margin-top: 250rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 35rpx;
  color: #fff;
  background: #FB1526;
  width: 80% !important;
  display: flex;
  align-items: center; /* 垂直居中 */
  justify-content: center; /* 水平居中 */
  
}

.other-container {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 90rpx;
  /* background: #EF6507; */
}

.line {
  background: #888;
  width: 150rpx;
  height: 2rpx;
}
