.container {
  display: flex;
  flex-direction: column;
  padding: 10px;
  background-color: #f9f9f9;
}

.filter-container {
  margin-bottom: 15px;
}

.filter-picker {
  padding: 10px;
  background-color: #fff;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.article-item {
  display: flex;
  flex-direction: row;
  margin-bottom: 15px;
  padding: 10px;
  background-color: #fff;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.article-image {
  width: 126px;
  height: 90px;
  margin-right: 15px;
  border-radius: 8px;
  object-fit: cover; /* 确保图片不变形 */
  align-self: center; /* 上下居中 */
}

.article-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.article-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 5px;
}

.article-author, .article-publish-date {
  font-size: 12px;
  color: #999;
}