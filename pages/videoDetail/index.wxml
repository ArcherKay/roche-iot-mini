<view class="container">
  <!-- 视频播放区 -->
  <!-- <view class="video-player">
    <video src="{{videoItem.downloadPath}}" controls></video>
  </view> -->
  
<view class="video-player">
    <!-- <video 
      id="myVideo" 
      src="{{videoItem.downloadPath}}" 
      controls 
      autoplay 
      bindplay="onVideoPlay"
      bindpause="onVideoPause"
      bindtimeupdate="onTimeUpdate"
      bindended="onVideoEnded"
    ></video> -->
    <player-component id="tvp-id" playerid="tvp" vid="s00242sxrne">
    <!-- 里面可以放插槽 -->
      <view slot="bottom-left-ctrl-btn" bind:tap="callback">左下角的自定义按钮</view>
      <view slot="top-right-ctrl-btn" bind:tap="callback">右上角的自定义按钮</view>
      <view slot="bottom-right-ctrl-btn" bind:tap="callback">右下角的自定义按钮</view>
      <view slot="default" bind:tap="callback">默认slot</view>
    </player-component>
  </view>

  <!-- 视频详情区 -->
  <view class="video-details">
    <view class="left-details">
      <view class="course-title">健康与急救线上课程</view>
      <view class="video-name">{{videoName}}</view>
      <view class="video-duration">视频时长：{{videoDuration}}</view>
    </view>
    <view class="right-details">
       <view class="learning-progress">学习进度</view>
       <view class="learning-percent">{{learningProgress}}%</view>
    </view>
    
    
  </view>
  
  <!-- 静态图片 -->
  <view class="static-image">
    <image src="/static/img/xm.jpg" mode="widthFix"></image>
  </view>
</view>