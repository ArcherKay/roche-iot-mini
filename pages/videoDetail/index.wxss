.container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
}

.video-player {
  flex: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #000;
}

.video-player video {
  width: 100%;
  height: 100%;
}

.video-details {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 20px;
  background-color: #fff;
  width: 90%;
  height: 60px;
  align-items: center;
}

.left-details {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  /* background-color: #a710de; */
}

.course-title {
  font-size: 14px;
  color: #818181;
  margin-bottom: 5px;
  /* background-color: aqua; */
  line-height: 14px;
}

.video-name {
  font-size: 18px;
  margin-bottom: 5px;
  line-height: 18px;
  font-weight: 400;
  color: #111111;
  font-family: AlibabaPuHuiTi-Regular, AlibabaPuHuiTi;
  margin-top: 5px;
}

.video-duration {
  font-size: 12px;
  color: #666;
  /* background-color: #fa541c; */
  line-height: 12px;
  margin-top: 5px;
}

.right-details {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 16px;
  align-self: start;
  /* background-color: #a710de; */
}
.learning-progress {
  font-size: 14px;
  color: #818181;
  margin-bottom: 8px;
  line-height: 14px;
  /* background-color: #fa541c; */
}
.learning-percent {
  font-size: 16px;
  color: #fa541c;
  line-height: 16px;
  /* background-color: aqua; */
}



.static-image {
  flex: 3;
  display: flex;
  justify-content: center;
  align-items: center;
}

.static-image image {
  width: 100%;
  height: auto;
}


