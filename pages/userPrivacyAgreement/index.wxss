.table {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.table-row {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid #ddd;
}

.table-cell {
  flex: 1; /* 平均分配剩余空间 */
  padding: 8px;
  word-wrap: break-word; /* 允许在单词内换行 */
  overflow-wrap: break-word; /* 等同于 word-wrap */
  white-space: normal; /* 正常处理空白符，自动换行 */
}