<view class="container">
  <view class="buttons">
    <view class="button scan" bindtap="onCityPickerTap">
      <image src="/static/icon/lock.svg" class="icon"/>
    </view>
  </view>
  <block wx:for="{{videos}}" wx:key="id">
    <view class="video-item" bindtap="goToDetail" data-item="{{item}}">
      <!-- <view > -->
        <!-- <image class="video-image" src="/static/img/videoicon.png" /> -->
      <!-- </view>  -->
      <view class="icon-container">
        <image src="/static/img/videoicon.png" class="background-image"></image>
        <view class="top-overlay">
          <text class="top-title">健康与急救课程</text>
        </view>
        <view class="overlay">
          <text class="title">{{item.videoName}}</text>
        </view>
      </view> 
      <view class="video-info">
        <text class="video-title">{{item.videoName}}</text>
        <text class="video-duration">{{item.duration}}</text>
        <text class="video-progress">{{item.finishPercent == 0 ?'未学习':(item.finishPercent == 100 ?'已学完' : ('已学习:' + item.finishPercentRounded))}}</text>
      </view>
    </view>
  </block>
</view>