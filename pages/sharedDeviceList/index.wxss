page {
  min-height: 100%;
  background: #eef6ff;
  color: #263b4a;
  font-family: "Avenir Next", "PingFang SC", sans-serif;
  font-size: 30rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 24rpx;
}

.page-title {
  color: #29465b;
  font-size: 30rpx;
  font-weight: 600;
}

.page-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #70899a;
  font-size: 30rpx;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.share-invite-button {
  width: 100%;
  height: 78rpx;
  margin: 0 0 28rpx;
  border: 0;
  border-radius: 12rpx;
  color: #fff;
  background: #2d79b0;
  font-size: 28rpx;
  line-height: 78rpx;
}

.share-invite-button::after {
  border: 0;
}

.user-card {
  padding: 24rpx;
  border: 1rpx solid rgba(46, 105, 155, .1);
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(45, 91, 131, .06);
}

.user-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: #236999;
  background: #dceefd;
  font-size: 32rpx;
  font-weight: 600;
}

.user-info {
  min-width: 0;
  flex: 1;
  margin: 0 18rpx;
}

.device-name {
  color: #36566c;
  font-size: 30rpx;
  font-weight: 600;
}

.record-detail {
  margin-top: 8rpx;
  color: #70899a;
  font-size: 23rpx;
  font-weight: 400;
  word-break: break-all;
}

.record-role {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  color: #70899a;
  background: #eff3f6;
  font-size: 22rpx;
}

.record-role.admin-role {
  color: #247a56;
  background: #e4f3eb;
}

.record-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-left: 94rpx;
}

.record-action {
  min-width: 0;
  height: 64rpx;
  flex: 1;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid #c7ddeb;
  border-radius: 9rpx;
  background: #f8fbfd;
  font-size: 23rpx;
  line-height: 62rpx;
}

.record-action::after {
  border: 0;
}

.admin-action {
  color: #236999;
}

.remove-action {
  border-color: #ecd4cf;
  color: #a35d52;
}

.record-action[disabled] {
  opacity: .55;
}

.state-message,
.empty-state,
.error-state {
  padding: 100rpx 24rpx;
  color: #70899a;
  text-align: center;
}

.error-state {
  color: #a35d52;
}

.retry-button {
  width: 180rpx;
  height: 68rpx;
  margin: 28rpx auto 0;
  border: 1rpx solid #b9d5e8;
  border-radius: 10rpx;
  color: #2d79b0;
  background: #fff;
  font-size: 30rpx;
  line-height: 66rpx;
}

.retry-button::after {
  border: 0;
}

.error-note {
  margin-top: 18rpx;
  color: #a35d52;
  font-size: 30rpx;
}