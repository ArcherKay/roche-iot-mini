<view class="container">
  <view class="form">
    <view class="form-item">
      <label class="form-label">姓名</label>
      <input class="form-input" type="text" placeholder="请输入您的姓名" value="{{name}}" bindinput="handleInputChange" data-field="name" />
    </view>

    <view class="form-item">
      <label class="form-label">联系电话</label>
      <input class="form-input" type="tel" placeholder="请输入您的联系电话" value="{{phone}}" bindinput="handleInputChange" data-field="phone" />
    </view>

    <view class="form-item">
      <label class="form-label">邮箱地址</label>
      <input class="form-input" type="email" placeholder="请输入您的邮箱地址" value="{{email}}" bindinput="handleInputChange" data-field="email" />
    </view>

    <view class="form-item">
      <label class="form-label">所在城市</label>
      <input class="form-input" type="text" placeholder="请输入您所在的城市" value="{{city}}" bindinput="handleInputChange" data-field="city" />
    </view>

    <view class="form-item">
      <label class="form-label">急救培训需求或留言</label>
      <textarea class="form-textarea" placeholder="请输入您的急救培训需求或留言" value="{{remark}}" bindinput="handleInputChange" data-field="remark"></textarea>
    </view>

    <view class="button-container">
      <button class="submit-button" bindtap="handleSubmit">提交</button>
    </view>
  </view>
</view>
