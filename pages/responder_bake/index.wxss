.container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: white;
}

.map {
  flex: 1;
  width: 100%;
}

.toggle-button {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 999;
  padding: 5px 10px;
  background-color: #ffffff;
  border: 1px solid #ddd;
  border-radius: 5px;
  text-align: center;
}

.rescuer-list {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 33%;
  background-color: #ffffff;
  border-top: 1px solid #ddd;
  display: flex;
  flex-direction: column;
  overflow-y: scroll;
}


.rescuer-icon {
  width: 30px;
  height: 30px;
  margin-right: 10px;
}

.rescuer-info {
  display: flex;
  flex-direction: column;
}

.rescuer-name {
  font-size: 16px;
  font-weight: bold;
}

.rescuer-details {
  font-size: 14px;
  color: #888;
}




.rescuer-item {
  display: flex;
  align-items: center;
  padding: 10px;
  border-bottom: 1px solid #ddd;
}


